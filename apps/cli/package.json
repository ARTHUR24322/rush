{
  "name": "@rushvault/cli",
  "version": "0.1.6",
  "description": "RushVault CLI — Sauvegardez votre code en 1 commande",
  "homepage": "https://github.com/ARTHUR24322/rush",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ARTHUR24322/rush.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "rush-save": "bin/rush-save",
    "rushvault": "bin/rushvault"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.js --external:archiver --external:chalk --external:commander --external:form-data --external:node-fetch --external:ora",
    "dev": "tsc --watch",
    "prepublishOnly": "pnpm build",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "bin/",
    "dist/index.js",
    "README.md"
  ],
  "dependencies": {
    "archiver": "^7.0.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "form-data": "^4.0.0",
    "node-fetch": "^3.3.2",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@rushvault/crypto": "workspace:*",
    "@types/archiver": "^6.0.2",
    "@types/node": "^20.14.10",
    "esbuild": "^0.21.0",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
