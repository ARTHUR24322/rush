NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clé maître pour le chiffrement côté serveur (générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
MASTER_ENCRYPTION_KEY=your-64-char-hex-master-key

# URL publique de l'app (pour les redirections OAuth du CLI)
NEXT_PUBLIC_APP_URL=http://localhost:3000
